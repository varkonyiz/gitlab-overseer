{
  "name": "gitlab-overseer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint && npm run lint:security",
    "lint:security": "! grep -rnE '\\[(innerHTML|outerHTML)\\]' src --include=*.html --include=*.ts",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"public/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"public/**/*.json\""
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@siemens/ix": "^5.3.0",
    "@siemens/ix-angular": "^5.3.0",
    "@siemens/ix-echarts": "^4.1.1",
    "@siemens/ix-icons": "^3.7.0",
    "echarts": "^6.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
